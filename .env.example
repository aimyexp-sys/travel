# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real API keys.

POSTGRES_PASSWORD=moveinsync_dev_password

# Which narration provider the backend calls (Phase 4's NarrationClient).
# sarvam = SarvamAI (primary). openai = OpenAI (fallback if SarvamAI credits
# run out - same interface, switching this one value is the whole change).
LLM_PROVIDER=sarvam

SARVAM_API_KEY=your_sarvam_api_key_here
OPENAI_API_KEY=
